# ChatterMate ticket investigator — installed by install.sh into
# /etc/systemd/system/chattermate-ticket-investigator.service.
# __INSTALL_DIR__ and __APP_USER__ are replaced at install time.
# Runs the AI ticket investigation loop and the ticket lifecycle loop.
# Without this service, ticket AI investigation never runs.
[Unit]
Description=ChatterMate ticket investigator (AI ticket investigation + lifecycle)
After=network-online.target postgresql.service redis-server.service chattermate-backend.service
Wants=network-online.target

[Service]
Type=simple
User=__APP_USER__
Group=__APP_USER__
WorkingDirectory=__INSTALL_DIR__/backend
Environment=PYTHONUNBUFFERED=1
Environment=no_proxy=localhost,127.0.0.1
Environment=NO_PROXY=localhost,127.0.0.1
EnvironmentFile=__INSTALL_DIR__/backend/.env
ExecStart=__INSTALL_DIR__/backend/venv/bin/python -m app.workers.ticket_investigator
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
